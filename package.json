{
  "name": "@accessphs/accessemr-reference",
  "version": "1.0.1",
  "private": true,
  "description": "AccessEMR reference data (ICD-10, drug list, lab catalogue, drug-safety rules) and a local, dependency-free drug-safety engine for Node, browsers and React Native.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "react-native": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./node": {
      "types": "./dist/esm/node.d.ts",
      "import": "./dist/esm/node.js",
      "require": "./dist/cjs/node.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/esm/node.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "data",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\" \"tests/*.test.cjs\"",
    "build:data": "node scripts/build-data.mjs --core ../access-emr-core-safety",
    "check:data": "node scripts/build-data.mjs --core ../access-emr-core-safety --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
